# Cloudflare Pages cache rules.
# Vite emits content-hashed filenames into /assets/, so they can be cached
# forever — a new build produces new names and never collides.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media uses stable (non-hashed) filenames, so cache for a day and revalidate
# — long enough to help repeat visits, short enough that image swaps show up.
/media/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
