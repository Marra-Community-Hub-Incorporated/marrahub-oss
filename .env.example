VITE_SITE_URL=https://www.example.com

# Contact form provider endpoint. Leave blank until you create your own form
# backend/provider account.
VITE_FORMSPREE_ENDPOINT=

# Cloudflare Turnstile site key for the contact form (public, but environment
# specific). Leave blank for local static UI work.
VITE_CONTACT_TURNSTILE_SITE_KEY=

# ── Volunteer agreement form ────────────────────────────────────────────────
# Copy to `.env.local` for local dev, and set the same keys in Cloudflare Pages
# for production builds. Only VITE_* vars reach the browser — never put secrets here.

# Backend that receives signed volunteer agreements (the Azure Function URL).
#   Local dev (Azure Functions running locally):
#     VITE_VOLUNTEER_API_URL=http://localhost:7071/api/volunteer-agreement
#   Production (your deployed Function App):
#     VITE_VOLUNTEER_API_URL=https://<your-function-app>.azurewebsites.net/api/volunteer-agreement
VITE_VOLUNTEER_API_URL=http://localhost:7071/api/volunteer-agreement

# Cloudflare Turnstile site key for volunteer agreements (public, but environment
# specific). Leave blank for local static UI work.
VITE_TURNSTILE_SITE_KEY=

# Feature flag for the public volunteer flow (the /volunteer page + its nav links
# and CTAs). Leave unset during local dev — it defaults ON in dev and OFF in
# production builds. Set to `true` to turn the flow on for a deployed environment.
# VITE_VOLUNTEER_ENABLED=true
