{
  "name": "marrahub-website",
  "description": "Marra Community Hub marketing website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "homepage": "https://marrahub.com.au",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marra-Community-Hub-Incorporated/marrahub.git"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/seo-build.mjs",
    "dev": "vite",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.13.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@cloudflare/workers-types": "^4.20260630.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tailwindcss": "4.1.12",
    "typescript": "~5.6",
    "typescript-eslint": "^8.62.1",
    "vite": "6.4.3",
    "wrangler": "^4.105.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
