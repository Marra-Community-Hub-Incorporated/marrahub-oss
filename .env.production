VITE_SITE_URL=https://marrahub.com.au

# Volunteer agreement form — PUBLIC values (they ship in the browser bundle
# anyway; never put a real secret in a VITE_ var). Vite loads this file during
# `npm run build`, so the Cloudflare production build bakes in the right backend
# URL automatically — no dashboard build variable needed.
VITE_VOLUNTEER_API_URL=https://marra-volunteer-form-api-drb5ekbahgfdhtc6.australiaeast-01.azurewebsites.net/api/volunteer-agreement
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACksijQmW93tasP6

# The public volunteer flow is not open yet, so it is hidden on the live site:
# the /volunteer page redirects to /contact and its nav links/CTAs point at
# Contact instead. When the programme launches, flip this to `true` and redeploy.
VITE_VOLUNTEER_ENABLED=false
